<?xml version="1.0" encoding="UTF-8"?>
<!-- LaunchDaemon de l'agent Remina. Placé dans /Library/LaunchDaemons/. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>fr.nounourscorp.remina.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/remina/agent/Remina.Agent</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/opt/remina/agent</string>
  <key>RunAtLoad</key>
  <true/>
  <!-- Redémarre seulement sur sortie anormale : laisse la bascule de mise à jour relancer. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>/var/log/remina-agent.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/remina-agent.log</string>
</dict>
</plist>
