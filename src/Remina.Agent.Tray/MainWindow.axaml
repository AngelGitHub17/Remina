<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Remina.Agent.Tray.MainWindow"
        Title="Remina Agent" Width="420" Height="320"
        CanResize="False" WindowStartupLocation="CenterScreen"
        Background="#0f1115">
  <Window.Styles>
    <Style Selector="TextBlock.label"><Setter Property="Foreground" Value="#9aa3b2"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="TextBlock.value"><Setter Property="Foreground" Value="#e6e8ee"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Window.Styles>
  <Border Padding="22">
    <StackPanel Spacing="14">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Ellipse Width="12" Height="12" VerticalAlignment="Center" x:Name="StatusDot" Fill="#6b7280"/>
        <TextBlock Text="Remina Agent" FontSize="18" FontWeight="Bold" Foreground="#e6e8ee"/>
        <TextBlock x:Name="VersionText" Classes="label" VerticalAlignment="Bottom"/>
      </StackPanel>

      <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" >
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="État"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Classes="value" x:Name="StateText" Text="—"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Serveur"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" x:Name="ServerText" Text="—"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Poste"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" x:Name="MachineText" Text="—"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Dernier contact"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" x:Name="HeartbeatText" Text="—"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="Session distante"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Classes="value" x:Name="RdpText" Text="—"/>
      </Grid>

      <Border Background="#171a21" CornerRadius="8" Padding="12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="Suivi d'activité" Foreground="#e6e8ee" FontWeight="SemiBold"/>
            <TextBlock x:Name="ActivityText" Classes="label" Text="—"/>
          </StackPanel>
          <ToggleButton Grid.Column="1" x:Name="PrivateToggle" Content="Mode privé"
                        Click="OnTogglePrivate" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <Border Background="#171a21" CornerRadius="8" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="Étape du récap" Foreground="#e6e8ee" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="StepName" Watermark="Ce que tu fais (ex : Rémina)" Width="220"/>
            <Button x:Name="StepButton" Content="Démarrer" Click="OnStepToggle"/>
          </StackPanel>
          <TextBlock x:Name="StepStatus" Classes="label" Text=""/>
        </StackPanel>
      </Border>

      <TextBlock x:Name="ErrorText" Foreground="#ef4444" FontSize="12" TextWrapping="Wrap"/>

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Réduire" Click="OnHide"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
